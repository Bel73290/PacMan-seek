{
  "name": "pac-and-seek-spark-tests",
  "private": true,
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test test/domain.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-pac-and-seek \"node --test --test-concurrency=1 test/spark/*.test.js\"",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-pac-and-seek \"node --test --test-concurrency=1 test/domain.test.js test/spark/*.test.js\"",
    "deploy": "firebase deploy --only firestore"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0"
  }
}
