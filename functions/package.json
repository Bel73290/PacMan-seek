{
  "name": "pac-and-seek-server",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-pac-and-seek \"node --test test/rules/*.test.js\"",
    "deploy": "firebase deploy --only functions,firestore",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-pac-and-seek \"node --test --test-concurrency=1 test/domain.test.js test/rules/*.test.js test/integration/*.test.js\""
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "firebase": "^11.0.0",
    "firebase-tools": "^14.0.0"
  }
}
